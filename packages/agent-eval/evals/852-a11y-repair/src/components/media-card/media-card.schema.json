{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://schema.mydesignsystem.com/media-card.schema.json",
  "title": "Media Card",
  "description": "Illustration, heading, copy and topic labels, with a save action.",
  "type": "object",
  "required": ["title", "summary", "imageSrc"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "title": "Title",
      "description": "Card heading.",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "description": "One or two lines of supporting copy.",
      "type": "string"
    },
    "imageSrc": {
      "title": "Image source",
      "description": "Source of the card's illustration.",
      "type": "string"
    },
    "tags": {
      "title": "Tags",
      "description": "Short topic labels shown under the copy.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
