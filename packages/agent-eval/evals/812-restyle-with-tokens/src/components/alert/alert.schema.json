{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://schema.kickstartds.com/base/alert.schema.json",
  "title": "Alert",
  "description": "Inline message calling out status or consequence",
  "type": "object",
  "required": ["message"],
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "string",
      "title": "Message",
      "description": "Body copy of the alert"
    },
    "title": {
      "type": "string",
      "title": "Title",
      "description": "Optional bold heading above the message"
    },
    "variant": {
      "type": "string",
      "title": "Variant",
      "description": "Severity of the alert",
      "enum": ["info", "success", "warning", "danger"],
      "default": "info"
    },
    "compact": {
      "type": "boolean",
      "title": "Compact",
      "description": "Reduces padding for dense layouts",
      "default": false
    }
  }
}
