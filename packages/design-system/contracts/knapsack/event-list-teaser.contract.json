{
  "$schema": "https://knapsack-oss.github.io/design-system-contract/schemas/v0/component.contract.schema.json",
  "contractId": "event-list-teaser",
  "component": "Event List Teaser",
  "description": "Display an event teaser with date, title and location",
  "props": {
    "properties": {
      "ariaLabel": {
        "type": "string"
      },
      "category": {
        "type": "string"
      },
      "className": {
        "type": "string"
      },
      "ctaText": {
        "type": "string"
      },
      "date": {
        "type": "string"
      },
      "image": {
        "type": "object"
      },
      "location": {
        "type": "object"
      },
      "tags": {
        "type": "array",
        "default": [
          "Topic 1",
          "Topic 2"
        ]
      },
      "text": {
        "type": "string"
      },
      "time": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "url": {
        "type": "string"
      }
    },
    "required": [
      "date",
      "location",
      "title"
    ],
    "additionalProperties": false
  },
  "slots": [
    "tags"
  ]
}
