{
  "$schema": "https://knapsack-oss.github.io/design-system-contract/schemas/v0/component.contract.schema.json",
  "contractId": "video-curtain",
  "component": "Video Curtain",
  "description": "Video curtain component for displaying a video background with overlay text and buttons.",
  "props": {
    "properties": {
      "buttons": {
        "type": "array"
      },
      "colorNeutral": {
        "type": "boolean",
        "default": false
      },
      "headline": {
        "type": "string"
      },
      "highlightText": {
        "type": "boolean",
        "default": false
      },
      "overlay": {
        "type": "boolean",
        "default": false
      },
      "sub": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "textPosition": {
        "type": "string",
        "enum": [
          "center",
          "bottom",
          "left",
          "right",
          "corner"
        ],
        "default": "center"
      },
      "video": {
        "type": "object"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "slots": [
    "buttons"
  ]
}
