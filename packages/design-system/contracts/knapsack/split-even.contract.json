{
  "$schema": "https://knapsack-oss.github.io/design-system-contract/schemas/v0/component.contract.schema.json",
  "contractId": "split-even",
  "component": "Split Even",
  "description": "Split even layout component for dividing content into two equal sections.",
  "props": {
    "properties": {
      "contentGutter": {
        "type": "string",
        "enum": [
          "small",
          "default",
          "large",
          "none"
        ],
        "default": "default"
      },
      "contentMinWidth": {
        "type": "string",
        "enum": [
          "narrow",
          "medium",
          "wide"
        ],
        "default": "medium"
      },
      "firstComponents": {
        "type": "array"
      },
      "firstLayout": {
        "type": "object"
      },
      "horizontalGutter": {
        "type": "string",
        "enum": [
          "large",
          "default",
          "small",
          "none"
        ],
        "default": "default"
      },
      "mobileReverse": {
        "type": "boolean",
        "default": false
      },
      "secondComponents": {
        "type": "array"
      },
      "secondLayout": {
        "type": "object"
      },
      "verticalAlign": {
        "type": "string",
        "enum": [
          "top",
          "center",
          "bottom",
          "sticky"
        ],
        "default": "top"
      },
      "verticalGutter": {
        "type": "string",
        "enum": [
          "large",
          "default",
          "small",
          "none"
        ],
        "default": "default"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "slots": [
    "firstComponents",
    "secondComponents"
  ]
}
