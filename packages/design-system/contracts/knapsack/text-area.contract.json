{
  "$schema": "https://knapsack-oss.github.io/design-system-contract/schemas/v0/component.contract.schema.json",
  "contractId": "text-area",
  "component": "TextArea",
  "description": "TextArea buttons allow users to select a single option from a list of mutually exclusive options.",
  "props": {
    "properties": {
      "className": {
        "type": "string"
      },
      "disabled": {
        "type": "boolean",
        "default": false
      },
      "hideLabel": {
        "type": "boolean"
      },
      "hint": {
        "type": "string"
      },
      "icon": {
        "type": "string"
      },
      "invalid": {
        "type": "boolean"
      },
      "invalidMessage": {
        "type": "string"
      },
      "label": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "placeholder": {
        "type": "string"
      },
      "value": {
        "type": "string"
      }
    },
    "required": [
      "label"
    ],
    "additionalProperties": false
  }
}
